#!/bin/sh
# Delegates to scripts/pre-commit-check.ps1 -- see that file and
# ROUTING.md's Hard Constraints for what this enforces and why.
# Requires `git config core.hooksPath .githooks` to actually run
# (Architecture.md section 6) -- this file being tracked does not activate it.
#
# The interpreter is resolved, not assumed. pwsh (PowerShell 7) is absent on some
# machines this repo is used from, and invoking it unconditionally exits 127 with a
# "command not found" that reads like a repo bug rather than a missing dependency.
# Real case: .claude/hooks/session-start.sh activated these hooks and then failed to
# install pwsh, so every commit in that session failed for a reason nothing explained.
repo_root=$(git rev-parse --show-toplevel)

if command -v pwsh >/dev/null 2>&1; then
    ps_exe=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then
    ps_exe=powershell.exe
else
    echo "pre-commit: neither 'pwsh' nor 'powershell.exe' found -- the structural-changes check did NOT run." >&2
    echo "            Install PowerShell, or bypass deliberately with: git commit --no-verify" >&2
    exit 1
fi

"$ps_exe" -NoProfile -File "$repo_root/scripts/pre-commit-check.ps1"
exit $?
